# ==== Postgres ====
POSTGRES_USER=clonedetect
POSTGRES_PASSWORD=clonedetect_dev_password
POSTGRES_DB=clonedetector
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clonedetect:clonedetect_dev_password@postgres:5432/clonedetector

# ==== Redis ====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==== Storage ====
# "local" = filesystem under ./storage, "minio" = S3-compatible object storage
STORAGE_BACKEND=local
STORAGE_APK_DIR=/storage/apks
STORAGE_REPORT_DIR=/storage/reports
STORAGE_TMP_DIR=/storage/tmp

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=apk-clone-detector
MINIO_SECURE=false

# ==== API ====
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_SIZE_MB=250
ANALYSIS_TIMEOUT_SECONDS=300
CORS_ORIGINS=http://localhost:3000

# ==== Frontend ====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ==== Scoring weights (must sum to 1.0) ====
WEIGHT_CERTIFICATE=0.15
WEIGHT_PACKAGE=0.10
WEIGHT_ICON=0.15
WEIGHT_STRINGS=0.15
WEIGHT_LAYOUT=0.10
WEIGHT_DEX=0.20
WEIGHT_RESOURCES=0.15

LOG_LEVEL=INFO
